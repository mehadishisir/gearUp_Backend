model RentalOrder{
    id String @id @default(uuid())
    startDate DateTime
    endDate DateTime
    status OrderStatus @default(PLACED)
    totalAmount Decimal 
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    customerId String
    customer User @relation(fields: [customerId],references: [id])
    items RentalOrderItem[]
    payment Payment?
    review Review?

    @@map("rental_orders")
}